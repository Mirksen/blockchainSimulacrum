# Installed to /etc/systemd/system/ on the lab host; see deploy/lab/README.md.
[Unit]
Description=Deploy proofofwork.fyi leaderboard from master (lab zone)
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
ExecStart=/opt/lab/proofofwork/bin/pull-deploy.sh
TimeoutStartSec=15min
