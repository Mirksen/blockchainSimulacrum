# Copy to .env next to compose.yaml and fill in. Never commit the real .env.

# HMAC key for challenges: at least 32 characters (the server refuses to start otherwise), e.g. `openssl rand -hex 32`.
CHALLENGE_SECRET=

# Comma-separated list of browser origins allowed to call the API.
ALLOWED_ORIGINS=https://proofofwork.fyi

# Token of the Cloudflare tunnel dedicated to this stack (Zero Trust dashboard).
TUNNEL_TOKEN=CHANGE_ME
