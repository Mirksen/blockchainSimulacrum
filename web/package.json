{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "check": "npm run lint && npm test && npm run build",
    "deploy:check": "npm run build && wrangler deploy --env production --dry-run",
    "deploy": "npm run build && wrangler deploy --env \"\"",
    "deploy:production": "npm run build && wrangler deploy --env production",
    "test:browser": "npm run build && node scripts/acceptance.mjs"
  },
  "dependencies": {
    "@scure/bip32": "2.4.0",
    "@scure/bip39": "2.4.0",
    "buffer": "^6.0.3",
    "crypto-js": "^4.2.0",
    "elliptic": "^6.6.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^30.1.3",
    "playwright": "^1.64.1",
    "vite": "^7.2.4",
    "vite-plugin-node-polyfills": "^0.25.0",
    "vitest": "^5.0.5",
    "wrangler": "^4.153.0"
  }
